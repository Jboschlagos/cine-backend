# Copiar este archivo a .env.local y completar con tus valores reales.
# .env.local nunca se sube a GitHub (ya está en .gitignore).

# Neon: la sacás del dashboard de tu proyecto en https://neon.tech
DATABASE_URL=postgresql://usuario:contraseña@host/neondb?sslmode=require

# Better Auth: generar con `npx @better-auth/cli secret`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# TMDB: creá una cuenta gratis en https://www.themoviedb.org/settings/api
# y copiá el "API Read Access Token" (no la API Key clásica)
TMDB_API_READ_TOKEN=
