# Copiar este archivo a .env.local y completar con tus valores reales.
# .env.local nunca se sube a GitHub (ya está en .gitignore).

# Neon: la sacás del dashboard de tu proyecto en https://neon.tech
DATABASE_URL=postgresql://usuario:contraseña@host/neondb?sslmode=require

# Better Auth: generar con `npx @better-auth/cli secret`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# TMDB: creá una cuenta gratis en https://www.themoviedb.org/settings/api
# y copiá el "API Read Access Token" (no la API Key clásica)
TMDB_API_READ_TOKEN=

# Spotify (opcional): para buscar el álbum de la banda sonora en la ficha técnica.
# Crear una app en https://developer.spotify.com/dashboard (el dueño necesita Spotify Premium)
# y copiar "Client ID" y "Client secret" desde Settings. Sin esto, solo se usa MusicBrainz.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Cloudinary: dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
